{
	"name": "github",
	"version": "1.0.0",
	"description": "Shareable github metadata files for our organisation",
	"author": "@sapphire",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.eslint.json",
		"lint": "eslint --fix",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@actions/core": "^3.0.1",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@sapphire/prettier-config": "^2.0.0",
		"@sapphire/ts-config": "^6.0.0",
		"@types/node": "^24.19.2",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"eslint": "^10.15.0",
		"eslint-config-neon": "^0.5.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.10.1",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write",
		"*.{mjs,js,ts}": "eslint --fix --ext mjs,js,ts,mts"
	},
	"packageManager": "yarn@4.18.1"
}
